APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8100

# Prefer the Supabase Session/Transaction Pooler URL on IPv4 networks.
# The direct db.<project>.supabase.co host is IPv6-only and may fail locally.
DATABASE_URL=postgresql://postgres.YOUR_SUPABASE_PROJECT:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

SUPABASE_PROJECT_REF=YOUR_SUPABASE_PROJECT_REF
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=imports

# LLM — at least GEMINI_API_KEY is required for the AI chat to work
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
NVIDIA_API_KEY=
OPENAI_API_KEY=

# CORS — comma-separated list of allowed frontend origins
# In production set this to your deployed frontend URL, e.g.:
# ALLOWED_ORIGINS=https://mrmilk.vercel.app
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173,http://127.0.0.1:5000,http://127.0.0.1:5173

ALLOW_LOCAL_FILE_FALLBACK=true
UPLOAD_ALLOWED_ROLES=owner,ops
